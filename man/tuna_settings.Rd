\name{tuna_settings}
\alias{tuna_settings}
\title{Default settings for the illustrative tuna longline scenario}
\usage{tuna_settings()}
\value{A named list accepted by \code{simulate_tuna()}.}
\description{Returns the current tuna example settings. Vertical habitat and
HBF-to-depth parameters are illustrative placeholders and need
fishery-specific calibration before scientific interpretation.}
