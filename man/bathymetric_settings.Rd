\name{bathymetric_settings}
\alias{bathymetric_settings}
\title{Default settings for the four-species bathymetric scenario (Run 22)}
\usage{
bathymetric_settings()
}
\value{A named list accepted by \code{\link{simulate_bathymetric}}.}
\description{Settings of the original \code{OMcpueSIM22.R} example (scenario 2,
targeting changes). Species distributions are driven by bathymetry and
distance; the model has no vertical component. Prices change in three 10-year
blocks: years 1-10 favour species 1, years 11-20 species 2, and years 21-30
species 4.}
