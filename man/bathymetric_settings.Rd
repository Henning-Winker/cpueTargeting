\name{bathymetric_settings}
\alias{bathymetric_settings}
\title{Default settings for the four-species bathymetric scenario}
\usage{bathymetric_settings()}
\value{A named list of Run 22 model settings accepted by
\code{simulate_bathymetric()}.}
\description{Returns the four-species Run 22 settings from the original
\code{OMcpueSIM22.R} example. Species distributions and movement are associated
with bathymetry and horizontal distance; there is no vertical availability
component.}
